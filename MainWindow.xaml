<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkidLeaks"
        xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Name="SkidLeaks" x:Class="SkidLeaks.MainWindow"
        mc:Ignorable="d"
        Title="SkidLeaks" Height="300" Width="600" WindowStyle="None" ResizeMode="NoResize" Background="{x:Null}" Foreground="{x:Null}" AllowsTransparency="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SigmaLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="/Splice;component/Fonts/#Rounded Mplus 1c"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF7e7d81"/>
        </Style>

        <Style x:Key="AnimatedButtonBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33151320"/>
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.PreviewMouseDown">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.9" Duration="0:0:0.1"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.9" Duration="0:0:0.1"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1" Duration="0:0:0.1" BeginTime="0:0:0.1"/>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1" Duration="0:0:0.1" BeginTime="0:0:0.1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border BorderBrush="#FF12101a" BorderThickness="1" Background="#FF100C19" CornerRadius="8" MouseDown="Drag">
            <Grid>
                <Border x:Name="CloseButton" 
                        Style="{StaticResource AnimatedButtonBorderStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,5,0" 
                        Width="26" Height="26" 
                        CornerRadius="6" MouseLeftButtonDown="Close">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M18 6 L6 18" Stroke="#7e7d81" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M6 6 L18 18" Stroke="#7e7d81" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <Border x:Name="MinimiseButton" 
                        Style="{StaticResource AnimatedButtonBorderStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,33,0"
                        Width="26" Height="26" 
                        CornerRadius="6" MouseLeftButtonDown="Minimise">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M9 5 V7 A1.5 1.5 0 0 1 7 9 H5"
                                  Stroke="#7e7d81" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M19 9 H17 A1.5 1.5 0 0 1 15 7 V5"
                                  Stroke="#7e7d81" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M5 15 H7 A1.5 1.5 0 0 1 9 17 V19"
                                  Stroke="#7e7d81" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M15 19 V17 A1.5 1.5 0 0 1 17 15 H19"
                                  Stroke="#7e7d81" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Wpf:WebView2 x:Name="Editor" Margin="0,32,138,33"/>

                <ScrollViewer x:Name="ScriptHeader" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0,36,2,0" Width="132" Height="Auto" VerticalAlignment="Top" HorizontalAlignment="Right" MaxHeight="200">
                    <StackPanel x:Name="TabPanel" Width="132">
                        <Border CornerRadius="5" Background="#FF151324" Height="35" Width="132">
                            <Grid>
                                <Path Fill="#FF7e7d81" Data="M3.17157 5.17157C2 6.34315 2 8.22876 2 12C2 15.7712 2 17.6569 3.17157 18.8284C4.34315 20 6.22876 20 10 20H14C17.7712 20 19.6569 20 20.8284 18.8284C22 17.6569 22 15.7712 22 12C22 8.22876 22 6.34315 20.8284 5.17157C19.6569 4 17.7712 4 14 4H10C6.22876 4 4.34315 4 3.17157 5.17157ZM6.81782 7.78733C7.11779 7.74992 7.48429 7.74996 7.88383 7.75H10.1162C10.5157 7.74996 10.8822 7.74992 11.1822 7.78733C11.5109 7.82833 11.8612 7.9242 12.1624 8.19187C12.2138 8.23753 12.2625 8.28618 12.3081 8.33756C12.5758 8.63878 12.6717 8.98915 12.7127 9.31782C12.7501 9.61779 12.7501 9.98428 12.75 10.3838L12.75 10.425C12.75 10.8392 12.4142 11.175 12 11.175C11.5858 11.175 11.25 10.8392 11.25 10.425C11.25 9.97047 11.2486 9.69931 11.2242 9.50348C11.1998 9.30765 10.9965 9.2758 10.9965 9.2758C10.8007 9.25137 10.5295 9.25001 10.075 9.25001H9.75001V14.75H11C11.4142 14.75 11.75 15.0858 11.75 15.5C11.75 15.9142 11.4142 16.25 11 16.25H7.00001C6.58579 16.25 6.25001 15.9142 6.25001 15.5C6.25001 15.0858 6.58579 14.75 7.00001 14.75H8.25001V9.25001H7.925C7.47047 9.25001 7.19931 9.25137 7.00348 9.2758C7.00348 9.2758 6.80023 9.30765 6.7758 9.50348C6.75137 9.69931 6.75001 9.97047 6.75001 10.425C6.75001 10.8392 6.41422 11.175 6.00001 11.175C5.58579 11.175 5.25001 10.8392 5.25001 10.425L5.25 10.3838C5.24996 9.98428 5.24992 9.61779 5.28733 9.31782C5.32833 8.98915 5.4242 8.63878 5.69187 8.33756C5.73753 8.28618 5.78618 8.23753 5.83756 8.19187C6.13878 7.9242 6.48915 7.82833 6.81782 7.78733Z" Margin="10,0,0,0" Stretch="Fill" Width="20" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Label FontSize="13" Style="{DynamicResource SigmaLabel}" Content="Scripts" Margin="35,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border x:Name="ScriptBorder" BorderThickness="1" Margin="469,71,5,0" CornerRadius="0,0,12,0">
                    <ListBox x:Name="ScriptWorkspace" 
                         Margin="-1,-1,-1,-1" 
                         BorderBrush="{x:Null}"
                         Background="{x:Null}"
                         Foreground="#FFE6E6E6"
                         SelectionChanged="ScriptWorkspace_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="OverridesDefaultStyle" Value="true"/>
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter Property="Focusable" Value="false"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border CornerRadius="4"
                                    Background="#FF151324"
                                    BorderBrush="Transparent"
                                    BorderThickness="0" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style TargetType="{x:Type ScrollBar}">
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="OverridesDefaultStyle" Value="true"/>
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true"
                                   Width="8">
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                                                </Track.Thumb>
                                            </Track>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="FileIcon">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}">
                                                        <Setter Property="Fill" Value="#FF7e7d81"/>
                                                        <Setter Property="Data" Value="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Extension}" Value=".lua">
                                                                <Setter Property="Fill" Value="#FF7e7d81"/>
                                                                <Setter Property="Data" Value="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Extension}" Value=".luau">
                                                                <Setter Property="Fill" Value="#FF7e7d81"/>
                                                                <Setter Property="Data" Value="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Extension}" Value=".txt">
                                                                <Setter Property="Fill" Value="#FF7e7d81"/>
                                                                <Setter Property="Data" Value="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="#FF7e7d81" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="#FF151324"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="5,8"/>
                                <Setter Property="Margin" Value="1,2"/>
                                <EventSetter Event="UIElement.MouseRightButtonUp" Handler="ListBoxItem_RightClick"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF383351"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF342e4f"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
                <Border BorderThickness="1" Margin="6,265,462,5" Background="#FF151324" CornerRadius="4,4,4,4">
                    <Grid Margin="-1,0,-1,0">
                        <Border x:Name="ExecuteButton"
                            BorderThickness="1"
                            Style="{StaticResource AnimatedButtonBorderStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="26"
                            Height="26"
                            CornerRadius="6"
                            Background="{x:Null}" MouseLeftButtonDown="ExecuteClicked">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M5,5 A2,2 0 0 1 8.008,3.272 L20.005,10.27 A2,2 0 0 1 20.008,13.728 L8.008,20.27 A2,2 0 0 1 5,19 Z"
                                      Stroke="#7e7d81"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <Border x:Name="Attach"
                                BorderThickness="1"
                                Style="{StaticResource AnimatedButtonBorderStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="26"
                                Height="26"
                                CornerRadius="6"
                                Background="{x:Null}" Margin="26,0,0,0" MouseLeftButtonDown="AttachClicked">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M16,6 L7.586,14.586 A2,2 0 0,0 10.415,17.415 L18.829,8.829 A4,4 0 1,0 13.172,3.172 L4.793,11.723 A6,6 0 1,0 13.278,20.208 L21.657,11.657"
                                          Stroke="#7e7d81"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border x:Name="Clear"
                                BorderThickness="1"
                                Style="{StaticResource AnimatedButtonBorderStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="26"
                                Height="26"
                                CornerRadius="6"
                                Background="{x:Null}" Margin="52,0,0,0" MouseLeftButtonDown="ClearClicked">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M19,6 V20 A2,2 0 0,1 17,22 H7 A2,2 0 0,1 5,20 V6 M3,6 H21 M8,6 V4 A2,2 0 0,1 10,2 H14 A2,2 0 0,1 16,4 V6"
                                          Stroke="#7e7d81"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border x:Name="Save"
                                BorderThickness="1"
                                Style="{StaticResource AnimatedButtonBorderStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="26"
                                Height="26"
                                CornerRadius="6"
                                Background="{x:Null}" Margin="78,0,0,0" MouseLeftButtonDown="SaveClicked">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M15.2,3 A2,2 0 0,1 16.6,3.6 L20.4,7.4 A2,2 0 0,1 21,8.8 V19 A2,2 0 0,1 19,21 H5 A2,2 0 0,1 3,19 V5 A2,2 0 0,1 5,3 Z M17,21 V14 A1,1 0 0,0 16,13 H8 A1,1 0 0,0 7,14 V21 M7,3 V7 A1,1 0 0,0 8,8 H15"
                                          Stroke="#7e7d81"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border x:Name="Open"
                        BorderThickness="1"
                        Style="{StaticResource AnimatedButtonBorderStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Width="26"
                        Height="26"
                        CornerRadius="6"
                        Background="{x:Null}" Margin="104,0,0,0" MouseLeftButtonDown="OpenClicked">
                            <Viewbox Width="18" Height="18" Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6,14 L7.5,11.1 A2,2 0 0,1 9.24,10 H20 A2,2 0 0,1 21.94,12.5 L20.4,18.5 A2,2 0 0,1 18.45,20 H4 A2,2 0 0,1 2,18 V5 A2,2 0 0,1 4,3 H7.9 A2,2 0 0,1 9.59,3.9 L10.4,5.1 A2,2 0 0,0 12.07,6 H18 A2,2 0 0,1 20,8 V10"
                                          Stroke="#7e7d81"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                    </Grid>
                </Border>
                <Image Width="31" Margin="8,2,559,266" 
                       Source="pack://application:,,,/Resources/logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

